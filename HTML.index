<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tall Mommy's Forest</title>
    <style>
        body { 
            font-family: Arial, sans-serif; 
            background: linear-gradient(#0a1f0a, #1a0033); 
            color: #ff99cc; 
            text-align: center; 
            padding: 30px; 
            margin: 0;
        }
        h1 { color: #ff66aa; font-size: 2.4em; margin-bottom: 10px; }
        button { 
            background: #9900cc; color: white; padding: 18px 40px; 
            font-size: 22px; border: none; border-radius: 12px; 
            cursor: pointer; margin: 20px;
        }
        button:hover { background: #ff00aa; transform: scale(1.05); }
        #scene { 
            margin: 40px auto; max-width: 820px; font-size: 1.28em; 
            line-height: 1.75; background: rgba(0,0,0,0.5); 
            padding: 35px; border-radius: 15px; text-align: left;
        }
        .mommy { color: #ff3399; font-size: 1.35em; }
    </style>
</head>
<body>
    <h1>🌲 Tall Mommy in the Forest 🌲</h1>
    <p>You're walking alone at night...</p>
    <button onclick="summonMommy()">Walk Deeper Into The Forest</button>
    <div id="scene"></div>

    <script>
        const ties = [
            "wrists tightly bound behind your back with soft pink rope",
            "spread-eagle between two trees with velvet cuffs",
            "hogtied firmly on the mossy ground",
            "suspended in a full body rope harness from a branch",
            "forced into a tight ball tie",
            "arms locked in a strict reverse prayer position",
            "blindfolded and chained to a thick tree",
            "thighs tied together with your arms pinned to your sides" "teasing and playing with your helpless, exposed body",
            "smothering you beneath her thick, soft ass",
            "pressing her large, heavy breasts against your face" "cradling you possessively in her lap like her personal toy",
            "pinning you underneath her with her full weight",
            "carrying you over her shoulder like a captured prize",
            "spooning you tightly from behind, her legs wrapped around you",
            "holding you in a full nelson while you feel tiny against her"
        ];

        function summonMommy() {
            const tie = ties ;
            const action = actions[Math.floor(Math.random() * actions.length)];
            const hold = holds ;
            
            document.getElementById('scene').innerHTML = `
                <p class="mommy">💕 Suddenly, you hear a twig snap behind you...</p>
                <p>A tall, powerful woman silently emerges from the shadows. Before you can run, she grabs you from behind, one strong hand covering your mouth.</p>
                <p>"Shhh... such a cute little lost puppy wandering all alone," she whispers, her voice low and commanding. "You're mine now."</p>
                <p>With expert skill, she quickly ties you up... <strong>${tie}</strong>.</p>
                <p>Completely helpless, she begins ${action}, her body pressing against yours as she takes complete control.</p>
                <p>Finally, she pulls you close and holds you tightly... <strong>${hold}</strong>.</p>
                <p>"There we go," she purrs, stroking your hair. "All tied up and nowhere to go. Mommy’s going to keep you here for a long, long time..."</p>
                <button onclick="summonMommy()">New Random Scene</button>
            `;
        }
    </script>
</body>
</html>
